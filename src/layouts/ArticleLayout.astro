---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description: string;
  date: Date;
  source?: string;
  tags?: string[];
  canonicalURL?: string;
  cover?: string;
  coverAlt?: string;
  hideFirstHeading?: boolean;
  wideMedia?: boolean;
}

const {
  title,
  description,
  date,
  tags,
  canonicalURL,
  cover,
  coverAlt = '',
  hideFirstHeading = false,
  wideMedia = false,
} = Astro.props;

const isoDate = date.toISOString().slice(0, 10);
---

<BaseLayout title={title} description={description} ogType="article" canonicalURL={canonicalURL} ogImage={cover}>
  <div class="container article-page">
    <a href="/" class="article-back">
      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="m15 18-6-6 6-6"/>
      </svg>
      All articles
    </a>

    <article class:list={{ 'article--hide-first-heading': hideFirstHeading, 'article--wide-media': wideMedia }}>
      <header class="article-header">
        <h1 class="article-title">{title}</h1>
        <div class="article-meta">
          <time datetime={date.toISOString()}>{isoDate}</time>
        </div>
        {tags && tags.length > 0 && (
          <div class="article-card__tags" style="margin-top: 1rem;">
            {tags.map(tag => <span class="tag">{tag}</span>)}
          </div>
        )}
        {cover && (
          <img
            class="article-cover"
            src={cover}
            alt={coverAlt}
            loading="eager"
            fetchpriority="high"
          />
        )}
      </header>

      <div class="prose">
        <slot />
      </div>
    </article>
  </div>
</BaseLayout>
